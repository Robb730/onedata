{
  "rewrites": [
    {
      "source": "/((?!assets/|.*\\.(?:js|mjs|css|png|jpg|jpeg|svg|ico|json|woff2?|ttf|map)$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
